# Copy to .env and replace both example passwords before starting local services.
V2NOTE_MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
V2NOTE_MYSQL_PASSWORD=replace-with-a-long-random-app-password

# Set these in the shell used to start V2Note for the distributed runtime.
VTNOTE_DATABASE_URL=mysql+pymysql://v2note:replace-with-url-encoded-password@127.0.0.1:8768/v2note?charset=utf8mb4
VTNOTE_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:8769
VTNOTE_KAFKA_STAGE_TOPIC=v2note.stage-runs
VTNOTE_KAFKA_CONSUMER_GROUP=v2note-workers
VTNOTE_REDIS_URL=redis://127.0.0.1:8770/0
